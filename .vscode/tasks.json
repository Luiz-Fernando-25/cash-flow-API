{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Gerar classes MapStruct",
      "type": "shell",
      "command": "${workspaceFolder}\\mvnw.cmd",
      "args": ["compile", "-q"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "runOptions": {
